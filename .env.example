# Base URL of the external mobile-phones catalog API (no backend of our own — see README).
NEXT_PUBLIC_API_BASE_URL=https://prueba-tecnica-api-tienda-moviles.onrender.com

# Test/demo API key required by the brief on every request (x-api-key header).
